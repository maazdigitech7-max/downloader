# Copy to .env for local use. On Vercel set these in Project -> Settings -> Environment Variables.
# Never commit .env.

# ---- Required for "Connect Instagram" (link downloads) ----------------------
# Meta app: Business type, Instagram product, "API setup with Instagram login".
# Use the *Instagram* app ID/secret shown there (not the Facebook ones).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Random string of 32+ characters that encrypts the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production (Vercel). Changing it logs everyone out.
SESSION_SECRET=

# ---- Optional ---------------------------------------------------------------
# Public URL without trailing slash. On Vercel this is detected automatically; set it
# when you use a custom domain (and use the same domain in Meta's redirect URI).
BASE_URL=
# Defaults to BASE_URL + /auth/instagram/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_MAX_PAGES=6
# Footer "Contact" link. Leave empty to hide it.
CONTACT_EMAIL=
# Image converter size limit in MB (Vercel caps request bodies at 4.5 MB, so max 4).
MAX_UPLOAD_MB=4
RATE_LIMIT_API=300
RATE_LIMIT_HEAVY=30
# Local development only
PORT=3000
